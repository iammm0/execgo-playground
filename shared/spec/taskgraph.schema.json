{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://execgo-playground/shared/spec/taskgraph.schema.json",
  "title": "TrainingRequest",
  "type": "object",
  "required": [
    "request_id",
    "execgo_endpoint",
    "tasks"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "execgo_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "poll": {
      "type": "object",
      "properties": {
        "interval_ms": {
          "type": "integer",
          "minimum": 100
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
