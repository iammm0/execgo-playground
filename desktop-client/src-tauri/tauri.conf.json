{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExecGo Playground",
  "version": "0.1.0",
  "identifier": "com.execgo.playground.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ExecGo Playground",
        "width": 1460,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
