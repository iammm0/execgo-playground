{
  "request_id": "retry-timeout-001",
  "execgo_endpoint": "http://localhost:8080",
  "poll": {
    "interval_ms": 1000,
    "max_attempts": 20
  },
  "tasks": [
    {
      "id": "delayed",
      "type": "sleep",
      "params": {
        "duration_ms": 9000
      },
      "retry": 0,
      "timeout": 2000
    },
    {
      "id": "downstream",
      "type": "file",
      "params": {
        "action": "write",
        "path": "tmp.txt",
        "content": "ok"
      },
      "depends_on": [
        "delayed"
      ]
    }
  ]
}
