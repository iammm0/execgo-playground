          "type": "number"
        },
        "max_tokens": {
          "default": 1200,
          "title": "Max Tokens",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 60000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "seed": {
          "default": 7,
