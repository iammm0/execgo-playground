{
  "request_id": "hitl-001",
  "execgo_endpoint": "http://localhost:8080",
  "poll": {
    "interval_ms": 1000,
    "max_attempts": 30
  },
  "tasks": [
    {
      "id": "generate-plan",
      "type": "noop",
      "params": {
        "message": "plan ready"
      }
    },
    {
      "id": "human-approval",
      "type": "noop",
      "params": {
        "message": "approved=true"
      },
      "depends_on": [
        "generate-plan"
      ]
    },
    {
      "id": "execute-after-approval",
      "type": "shell",
      "params": {
        "command": "echo",
        "args": [
          "approved"
        ]
      },
      "depends_on": [
        "human-approval"
      ]
    }
  ]
}
